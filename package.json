{
  "name": "rurale-nous",
  "version": "0.1.0",
  "description": "Veille municipale du Québec rural — transport collectif, bonnes pratiques, corrélations RIMQ/UMQ/FMQ",
  "main": "src/main/index.js",
  "author": "Rurale-Nous",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run vite\" \"wait-on http://localhost:5173 && electron .\"",
    "vite": "vite",
    "build": "vite build && electron-builder",
    "build:mac": "electron-builder --mac --universal",
    "lint": "eslint src --ext .js,.jsx"
  },
  "dependencies": {
    "groq-sdk": "^0.5.0",
    "better-sqlite3": "^9.4.3",
    "cheerio": "^1.0.0-rc.12",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0",
    "axios": "^1.6.7",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "ca.rurale-nous.app",
    "productName": "Rurale-Nous",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.news",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "minimumSystemVersion": "10.13.0"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/services/**/*",
      "data/.gitkeep",
      "!node_modules/**/*"
    ],
    "extraResources": [
      { "from": "data", "to": "data", "filter": ["**/*"] }
    ]
  }
}
