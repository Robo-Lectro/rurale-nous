{
  "name": "rurale-nous",
  "version": "0.1.0",
  "description": "Veille municipale du Québec rural — transport collectif, bonnes pratiques, corrélations RIMQ/UMQ/FQM",
  "main": "src/main/index.js",
  "author": "Rurale-Nous",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run vite\" \"wait-on http://localhost:5173 && electron .\"",
    "vite": "vite",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "build:mac": "npm run build:mac:x64",
    "build:mac:x64": "npm run build:renderer && electron-builder --mac dmg --x64",
    "build:mac:arm64": "npm run build:renderer && electron-builder --mac dmg --arm64",
    "build:win": "npm run build:win:portable",
    "build:win:portable": "npm run build:renderer && electron-builder --win portable --x64",
    "build:win:dir": "npm run build:renderer && electron-builder --win dir --x64",
    "lint": "eslint src --ext .js,.jsx"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.0.0",
    "electron-store": "^8.1.0",
    "groq-sdk": "^0.5.0",
    "node-cron": "^4.2.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^8.2.2",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^8.0.14",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "ca.rurale-nous.app",
    "productName": "Rurale-Nous",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.news",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "minimumSystemVersion": "10.13.0"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "files": [
      "dist/renderer/**/*",
      "src/main/**/*",
      "src/services/**/*",
      "data/.gitkeep"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
